---
import '@/styles/global.css';
import { SITE } from '@/lib/site';
import { organization, localBusiness } from '@/lib/schema';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import WhatsAppFloat from '@/components/WhatsAppFloat.astro';

interface Props {
  title: string; // ≤60 chars — unique per page
  description: string; // ≤155 chars — unique per page
  /** Extra JSON-LD nodes (FAQPage, Service, BreadcrumbList, Article, Offer…) */
  schema?: object[];
  ogImage?: string;
  ogType?: string;
  /** GA4 event fired once on page view (e.g. 'membership_view') */
  viewEvent?: string;
}
const { title, description, schema = [], ogImage = '/og/og-default.png', ogType = 'website', viewEvent } = Astro.props;

const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site);
const ogImageAbs = new URL(ogImage, Astro.site);
const jsonLd = { '@context': 'https://schema.org', '@graph': [organization(), localBusiness(), ...schema] };

// GA4: set PUBLIC_GA4_ID (e.g. G-XXXXXXX) in the environment to activate.
// Loads ONLY after cookie consent (see inline script below).
const GA4_ID = import.meta.env.PUBLIC_GA4_ID ?? '';
// Google Search Console: set PUBLIC_GSC_VERIFICATION to the meta-tag content value.
const GSC = import.meta.env.PUBLIC_GSC_VERIFICATION ?? '';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#2E2320" />
    {GSC && <meta name="google-site-verification" content={GSC} />}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Mini Coworking Spaces + Mini Studio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_IN" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="flex min-h-screen flex-col" data-view-event={viewEvent}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded-full focus:bg-espresso focus:px-5 focus:py-2.5 focus:text-cream"
    >Skip to content</a>

    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat />

    <!-- Cookie consent (minimal, privacy-respecting): analytics loads only after "Allow". -->
    <div
      id="consent"
      class="fixed inset-x-4 bottom-24 z-50 mx-auto hidden max-w-md rounded-3xl bg-espresso p-5 text-cream shadow-card-hover sm:inset-x-auto sm:left-5 sm:bottom-5"
      role="dialog"
      aria-label="Cookie notice"
    >
      <p class="text-sm leading-relaxed text-cream/85">
        We use one analytics cookie to understand what's useful here. No ads, no tracking across the web.
        <a href="/privacy" class="underline underline-offset-2 hover:text-cream">Privacy policy</a>
      </p>
      <div class="mt-3.5 flex gap-2">
        <button id="consent-yes" class="min-h-11 flex-1 rounded-full bg-amber-brand px-4 text-sm font-semibold text-espresso hover:bg-[#e89a52]">Allow</button>
        <button id="consent-no" class="min-h-11 flex-1 rounded-full border border-cream/30 px-4 text-sm font-semibold text-cream hover:bg-cream/10">No thanks</button>
      </div>
    </div>

    <script is:inline define:vars={{ GA4_ID }}>
      (function () {
        var KEY = 'mini-consent';
        var banner = document.getElementById('consent');

        function loadGA() {
          if (!GA4_ID) return; // no ID configured → nothing to load
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA4_ID;
          document.head.appendChild(s);
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { dataLayer.push(arguments); };
          gtag('js', new Date());
          gtag('config', GA4_ID, { anonymize_ip: true });
        }

        var choice = localStorage.getItem(KEY);
        if (choice === 'yes') loadGA();
        else if (!choice && GA4_ID && banner) banner.classList.remove('hidden');

        document.getElementById('consent-yes')?.addEventListener('click', function () {
          localStorage.setItem(KEY, 'yes'); banner.classList.add('hidden'); loadGA();
        });
        document.getElementById('consent-no')?.addEventListener('click', function () {
          localStorage.setItem(KEY, 'no'); banner.classList.add('hidden');
        });

        function track(name) {
          if (typeof window.gtag === 'function' && name) gtag('event', name);
        }
        // Delegated click tracking: any element with data-event="…"
        document.addEventListener('click', function (e) {
          var el = e.target instanceof Element ? e.target.closest('[data-event]') : null;
          if (el) track(el.getAttribute('data-event'));
        });
        // Custom events (e.g. lead_submit fired from the form success state)
        window.addEventListener('mini:track', function (e) { track(e.detail && e.detail.event); });
        // Page-level view events (e.g. membership_view) via <body data-view-event>
        var viewEvent = document.body.getAttribute('data-view-event');
        if (viewEvent) track(viewEvent);
      })();
    </script>
  </body>
</html>
