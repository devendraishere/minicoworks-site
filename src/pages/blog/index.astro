---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Doodle from '@/components/Doodle.astro';
import { breadcrumbs } from '@/lib/schema';
import { SITE } from '@/lib/site';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Blog', href: '/blog' },
];

const categories = ['Coworking & remote work', 'Podcasting & content', 'Jaipur startup scene', 'Productivity & community'];

const fmt = (d: Date) => d.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base
  title="The Mini Journal — Coworking, Creators & Jaipur"
  description="Notes from Mini — on coworking and remote work, podcasting and content, the Jaipur startup scene, and building in good company."
  schema={[breadcrumbs(crumbs)]}
>
  <Breadcrumbs items={crumbs} />

  <section class="mx-auto max-w-6xl px-4 pb-12 pt-10 sm:px-6 sm:pt-14">
    <h1 class="text-4xl font-semibold leading-[1.1] text-espresso sm:text-5xl">The Mini Journal</h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink/75">
      Notes on coworking, creating, and building in Jaipur — written from the room, not a content calendar.
    </p>
    <ul class="mt-6 flex flex-wrap gap-2">
      {categories.map((c) => (
        <li class="rounded-full bg-white px-4 py-1.5 text-xs font-semibold text-espresso/70 shadow-card">{c}</li>
      ))}
    </ul>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => (
        <article class="group relative flex flex-col rounded-3xl bg-white p-7 shadow-card transition-shadow hover:shadow-card-hover">
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-teal-deep">{post.data.tags[0] ?? 'Journal'}</p>
          <h2 class="mt-3 text-xl font-semibold leading-snug text-espresso">
            <a href={`/blog/${post.id.replace(/\.(md|mdx)$/, '')}`} class="after:absolute after:inset-0 group-hover:text-amber-deep">{post.data.title}</a>
          </h2>
          <p class="mt-3 flex-1 text-sm leading-relaxed text-ink/70">{post.data.description}</p>
          <p class="mt-5 text-xs text-ink/70">{post.data.author} · <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time></p>
        </article>
      ))}
    </div>

    <!-- Newsletter capture (Netlify form) -->
    <div class="mt-14 rounded-3xl bg-espresso p-8 text-cream sm:p-10">
      <div class="grid items-center gap-6 lg:grid-cols-[1.3fr_1fr]">
        <div>
          <Doodle kind="sparkle" class="h-8 w-8 text-amber-brand" />
          <h2 class="mt-3 text-2xl font-semibold">Get the Journal by email</h2>
          <p class="mt-2 text-sm leading-relaxed text-cream/75">
            One useful note at a time — no spam, unsubscribe whenever.
          </p>
        </div>
        <!-- No form backend on GitHub Pages yet — subscribe requests go via WhatsApp.
             TODO: swap to Netlify Forms / a newsletter service once hosting/email is ready. -->
        <form id="newsletter-form" class="flex flex-col gap-3 sm:flex-row" data-whatsapp={SITE.whatsappUrl}>
          <label for="nl-email" class="sr-only">Email address</label>
          <input
            id="nl-email"
            name="email"
            type="email"
            required
            placeholder="you@example.com"
            class="min-h-11 w-full flex-1 rounded-full border border-cream/25 bg-cream/10 px-5 text-cream placeholder:text-cream/40 focus:border-amber-brand"
          />
          <button type="submit" class="min-h-11 rounded-full bg-amber-brand px-6 font-semibold text-espresso hover:bg-[#e89a52]">Subscribe</button>
        </form>
        <script>
          const nl = document.getElementById('newsletter-form') as HTMLFormElement | null;
          nl?.addEventListener('submit', (e) => {
            e.preventDefault();
            const email = new FormData(nl).get('email');
            window.open(`${nl.dataset.whatsapp}?text=${encodeURIComponent(`Hi Mini! Please add me to the Journal newsletter: ${email}`)}`, '_blank', 'noopener');
          });
        </script>
      </div>
    </div>
  </section>
</Base>
