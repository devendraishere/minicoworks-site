---
import { getCollection, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Button from '@/components/Button.astro';
import { breadcrumbs, article } from '@/lib/schema';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.(md|mdx)$/, '') },
    props: { post, all: posts },
  }));
}

const { post, all } = Astro.props;
const { Content } = await render(post);
const slug = post.id.replace(/\.(md|mdx)$/, '');

// Reading time (~220 wpm on the raw body)
const words = (post.body ?? '').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 220));

// Related posts: shared tag first, then recency
const related = all
  .filter((p) => p.id !== post.id)
  .sort((a, b) => {
    const shared = (p: typeof a) => (p.data.tags.some((t) => post.data.tags.includes(t)) ? 1 : 0);
    return shared(b) - shared(a) || b.data.date.valueOf() - a.data.date.valueOf();
  })
  .slice(0, 2);

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Blog', href: '/blog' },
  { name: post.data.title, href: `/blog/${slug}` },
];

const schema = [
  breadcrumbs(crumbs),
  article({
    title: post.data.title,
    description: post.data.description,
    url: `/blog/${slug}`,
    datePublished: post.data.date.toISOString(),
    author: post.data.author,
  }),
];

const fmt = (d: Date) => d.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={post.data.title} description={post.data.description} schema={schema} ogType="article">
  <Breadcrumbs items={[crumbs[0], crumbs[1], { name: 'Article', href: `/blog/${slug}` }]} />

  <article class="mx-auto max-w-6xl px-4 pb-16 pt-8 sm:px-6">
    <header class="prose-mini mx-auto">
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-teal-deep">{post.data.tags[0] ?? 'Journal'}</p>
      <h1 class="mt-3 text-3xl font-semibold leading-[1.15] text-espresso sm:text-4xl">{post.data.title}</h1>
      <p class="mt-4 text-sm text-ink/70">
        {post.data.author} · <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time> · {minutes} min read
      </p>
    </header>
    <div class="prose-mini mx-auto mt-8">
      <Content />
    </div>

    <footer class="prose-mini mx-auto mt-12 border-t border-espresso/10 pt-10">
      <div class="rounded-3xl bg-cream p-7 text-center">
        <p class="font-display text-xl font-semibold text-espresso">Work, record, and grow — in a room that knows you.</p>
        <div class="mt-5 flex flex-wrap justify-center gap-3">
          <Button href="/contact#tour" event="book_tour_click">Book a tour</Button>
          <Button href="/studio" variant="secondary" event="studio_book_click">See the studio</Button>
        </div>
      </div>

      {related.length > 0 && (
        <div class="mt-10">
          <h2 class="font-display text-lg font-semibold text-espresso">Keep reading</h2>
          <ul class="mt-4 space-y-3">
            {related.map((r) => (
              <li>
                <a href={`/blog/${r.id.replace(/\.(md|mdx)$/, '')}`} class="font-semibold text-teal-deep underline underline-offset-4 hover:text-amber-deep">
                  {r.data.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </footer>
  </article>
</Base>
