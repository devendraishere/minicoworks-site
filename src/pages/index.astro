---
import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
import Doodle from '@/components/Doodle.astro';
import Todo from '@/components/Todo.astro';
import PillarCard from '@/components/PillarCard.astro';
import SpaceCard from '@/components/SpaceCard.astro';
import TestimonialCard from '@/components/TestimonialCard.astro';
import FAQAccordion from '@/components/FAQAccordion.astro';
import CTASection from '@/components/CTASection.astro';
import MapEmbed from '@/components/MapEmbed.astro';
import { SITE, SPACES, todoMark } from '@/lib/site';
import { faqPage, service } from '@/lib/schema';

const faqs = [
  { q: 'Where is Mini located?', a: `We're in Jaipur. ${todoMark('address / locality — confirm')}` },
  { q: 'Do you have a podcast studio?', a: 'Yes — Mini Studio is on site. You can book it with or without a membership.' },
  { q: 'Can I try before joining?', a: 'Absolutely. Book a free tour, or ask us about a day pass.' },
  { q: "What's included in a membership?", a: `Wi-Fi, coffee, meeting-room credits, community events, and concierge help. ${todoMark('confirm inclusions')}` },
  { q: 'Do you have private cabins for small teams?', a: `Yes — quiet, lockable cabins for small teams. ${todoMark('confirm team sizes')}` },
  { q: 'What does it cost?', a: `Simple monthly plans and hourly studio slots. ${todoMark('confirm pricing')} See the membership page for plan details.` },
  { q: 'Is there parking and good Wi-Fi?', a: todoMark('confirm parking + Wi-Fi details') },
];
// Schema answers: plain-text, unconfirmed details omitted rather than invented.
const faqSchema = faqPage([
  { q: 'Do you have a podcast studio?', a: 'Yes — Mini Studio is on site. You can book it with or without a membership.' },
  { q: 'Can I try before joining?', a: 'Yes. Book a free tour, or ask us about a day pass.' },
]);

const pillars = [
  { title: 'Known, not numbered.', body: 'We keep the room curated and actually introduce people. You join a community, not a crowd.', icon: 'sparkle', accent: 'amber' },
  { title: 'Your day, handled.', body: 'Coffee, rooms, calls, packages, printing, studio setup — sorted. You just do your best work.', icon: 'coffee', accent: 'teal' },
  { title: 'Work + content under one roof.', body: 'A real podcast and content studio on site. Build your business and your brand in the same place.', icon: 'mic', accent: 'berry' },
  { title: 'A Jaipur launchpad.', body: 'Local network, collaborator and mentor intros, and a path into our incubator.', icon: 'arrow', accent: 'espresso' },
] as const;

const schema = [
  faqSchema,
  service({ name: 'Coworking Space in Jaipur', description: 'Boutique coworking in Jaipur — hot desks, dedicated desks, private cabins and meeting rooms with a curated community and concierge service.', url: '/spaces', type: 'Coworking space' }),
  service({ name: 'Podcast & Content Studio in Jaipur', description: 'Turnkey podcast and content studio in Jaipur — walk in, hit record, walk out with pro content.', url: '/studio', type: 'Recording studio' }),
];
---
<Base
  title="Mini — Coworking Space & Podcast Studio in Jaipur"
  description="A boutique coworking space and creator studio in Jaipur. Work, record and grow in a curated community that knows you — podcast studio built in. Book a tour."
  schema={schema}
>
  <!-- 1 · Hero -->
  <section class="bg-espresso text-cream">
    <div class="mx-auto max-w-6xl px-4 pb-16 pt-14 sm:px-6 sm:pb-24 sm:pt-20">
      <p class="text-xs font-semibold uppercase tracking-[0.22em] text-amber-brand">Boutique coworking + creator studio · Jaipur</p>
      <h1 class="mt-5 max-w-3xl text-4xl font-semibold leading-[1.08] sm:text-6xl">
        Work, record, and grow — in a room that
        <span class="relative inline-block whitespace-nowrap">knows you.<Doodle kind="underline" class="absolute -bottom-2 left-0 w-full text-amber-brand" /></span>
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-cream/80">
        Mini is a boutique coworking space in Jaipur with a podcast studio built in — for creators, solopreneurs and small
        teams. Small on purpose: a curated community where your day is handled and your brand gets built.
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-3">
        <Button href="/contact#tour" size="lg" event="book_tour_click">Book a tour</Button>
        <Button href="/membership" size="lg" variant="ghost">See membership</Button>
        <a href={SITE.whatsappUrl} target="_blank" rel="noopener" data-event="whatsapp_click" class="min-h-11 inline-flex items-center px-2 text-sm font-medium text-cream/70 underline underline-offset-4 hover:text-cream">
          or message us on WhatsApp
        </a>
      </div>
      <p class="mt-10 text-sm text-cream/70">
        A curated community in <Todo label="locality" />, Jaipur · <Todo label="member count" /> and growing
      </p>
    </div>
  </section>

  <!-- 2 · The reframe -->
  <section class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 sm:py-20">
    <h2 class="text-3xl font-semibold text-espresso sm:text-4xl">Not a desk in a crowd.</h2>
    <p class="mt-5 text-lg leading-relaxed text-ink/75">
      You've tried the lonely home office and the anonymous desk-farm where "community" is a WhatsApp group nobody uses.
      Mini is the third option — a small, curated space where you're known by name, the little things are handled, and
      there's a real studio to build your brand. All under one roof.
    </p>
  </section>

  <!-- 3 · Four pillars -->
  <section class="bg-cream">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <h2 class="text-center text-3xl font-semibold text-espresso sm:text-4xl">Why people choose Mini</h2>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {pillars.map((p) => <PillarCard {...p} />)}
      </div>
    </div>
  </section>

  <!-- 4 · Mini Studio hero band -->
  <section class="bg-berry text-cream">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 sm:px-6 sm:py-24 lg:grid-cols-[1.2fr_1fr]">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-amber-brand">Mini Studio</p>
        <h2 class="mt-4 text-3xl font-semibold leading-tight sm:text-5xl">Walk in. Hit record. Walk out with pro content.</h2>
        <p class="mt-5 max-w-xl text-base leading-relaxed text-cream/85 sm:text-lg">
          Most coworking spaces give you a desk. We give you a studio too. Record podcasts, reels, interviews and brand
          content in a ready-to-go space — we handle the tech, you just create.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href="/studio" size="lg" event="studio_book_click">Book the studio</Button>
          <Button href="/studio" size="lg" variant="ghost">See what's included</Button>
        </div>
      </div>
      <div class="mx-auto">
        <Doodle kind="mic" class="h-40 w-40 text-cream/90 sm:h-56 sm:w-56" />
        <p class="mt-3 text-center text-xs text-cream/70">Real studio photos go here · <Todo label="studio photography" class="!text-cream !border-cream/50 !bg-cream/10" /></p>
      </div>
    </div>
  </section>

  <!-- 5 · Spaces -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
    <h2 class="text-3xl font-semibold text-espresso sm:text-4xl">Room to work, your way.</h2>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-ink/75">
      Flexible ways to make Mini your base — from a drop-in seat to a private cabin. Every plan comes with the community
      and the concierge, not just the furniture.
    </p>
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {SPACES.map((s) => <SpaceCard name={s.name} line={s.line} href={`/spaces/${s.slug}`} />)}
      <SpaceCard name="Studio Time" line="Add Mini Studio hours to any plan." href="/studio" showPrice={false} />
    </div>
    <div class="mt-9">
      <Button href="/membership" variant="secondary">Compare membership</Button>
    </div>
  </section>

  <!-- 6 · Community stories -->
  <section class="bg-cream">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <h2 class="text-3xl font-semibold text-espresso sm:text-4xl">The people make it Mini.</h2>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-ink/75">
        Real members, real momentum — founders, creators and small teams building side by side.
      </p>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        <TestimonialCard />
        <TestimonialCard />
        <TestimonialCard />
      </div>
      <div class="mt-9 flex flex-wrap items-center gap-5">
        <Button href="/community" variant="secondary">Read member stories</Button>
        <a href="/community#day-in-the-life" class="min-h-11 inline-flex items-center text-sm font-semibold text-teal-deep underline underline-offset-4 hover:text-amber-deep">
          A Day in the Life at Mini →
        </a>
      </div>
    </div>
  </section>

  <!-- 7 · How it works -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
    <h2 class="text-center text-3xl font-semibold text-espresso sm:text-4xl">Your day, handled.</h2>
    <ol class="mx-auto mt-10 grid max-w-4xl gap-5 sm:grid-cols-3">
      {[
        { n: '1', t: 'Book a tour', d: 'Come see the room.' },
        { n: '2', t: 'Pick your plan', d: 'No lock-in games.' },
        { n: '3', t: 'Just show up', d: 'We handle the rest.' },
      ].map((step) => (
        <li class="rounded-3xl bg-white p-7 text-center shadow-card">
          <span class="mx-auto flex h-11 w-11 items-center justify-center rounded-full bg-amber-brand font-display text-lg font-semibold text-espresso">{step.n}</span>
          <h3 class="mt-4 text-lg font-semibold text-espresso">{step.t}</h3>
          <p class="mt-1.5 text-sm text-ink/70">{step.d}</p>
        </li>
      ))}
    </ol>
    <p class="mt-8 text-center text-sm text-ink/70">
      Need something during the day? <a href={SITE.whatsappUrl} target="_blank" rel="noopener" data-event="whatsapp_click" class="font-semibold text-teal-deep underline underline-offset-4">WhatsApp us</a> and it's sorted.
    </p>
  </section>

  <!-- 8 · Membership teaser -->
  <section class="bg-cream">
    <div class="mx-auto max-w-6xl px-4 py-16 text-center sm:px-6 sm:py-20">
      <h2 class="text-3xl font-semibold text-espresso sm:text-4xl">Simple plans. No lock-in games.</h2>
      <div class="mx-auto mt-8 flex max-w-2xl flex-wrap items-center justify-center gap-3">
        {['Social', 'Flex', 'Resident'].map((name) => (
          <span class="rounded-full bg-white px-6 py-3 font-display text-lg font-semibold text-espresso shadow-card">{name} <Todo label="tier name" /></span>
        ))}
      </div>
      <p class="mt-5 text-sm text-ink/65">from ₹<Todo label="price" />/month</p>
      <div class="mt-7"><Button href="/membership">See membership</Button></div>
    </div>
  </section>

  <!-- 9 · Launchpad teaser -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
    <div class="grid items-center gap-8 rounded-3xl bg-teal-brand p-8 text-cream sm:p-12 lg:grid-cols-[1.5fr_auto]">
      <div>
        <h2 class="text-3xl font-semibold sm:text-4xl">More than a desk — a launchpad.</h2>
        <p class="mt-4 max-w-xl leading-relaxed text-cream/85">
          Building something? Mini runs a focused incubation track for early founders and creators — mentors,
          introductions, and demo-day content to help you grow.
        </p>
      </div>
      <Button href="/about#incubator" variant="ghost" size="lg">Explore the incubator</Button>
    </div>
  </section>

  <!-- 10 · Why Jaipur -->
  <section class="mx-auto max-w-3xl px-4 pb-16 text-center sm:px-6 sm:pb-20">
    <Doodle kind="sparkle" class="mx-auto h-9 w-9 text-amber-brand" />
    <h2 class="mt-3 text-3xl font-semibold text-espresso sm:text-4xl">A Jaipur space, for Jaipur's builders.</h2>
    <p class="mt-5 text-lg leading-relaxed text-ink/75">
      We're proudly local — Jaipur hospitality, a Jaipur network, and partners around the city. Not an imported chain; a
      home base built here, for the people building here.
    </p>
    <p class="mt-4 text-sm text-ink/70">
      Easy to reach from localities across Jaipur — <Todo label="list nearby areas (e.g. specific localities) once address is confirmed" />
    </p>
  </section>

  <!-- 11 · FAQ -->
  <section class="bg-cream">
    <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-20">
      <h2 class="text-center text-3xl font-semibold text-espresso sm:text-4xl">Questions, answered</h2>
      <div class="mt-9"><FAQAccordion items={faqs} /></div>
    </div>
  </section>

  <!-- 12 · Final CTA -->
  <CTASection>
    <div class="mx-auto mt-10 max-w-2xl text-left">
      <MapEmbed />
    </div>
  </CTASection>
</Base>
