---
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Button from '@/components/Button.astro';
import Todo from '@/components/Todo.astro';
import PricingCard from '@/components/PricingCard.astro';
import FAQAccordion from '@/components/FAQAccordion.astro';
import CTASection from '@/components/CTASection.astro';
import { SITE, PRICING, STUDIO_PRICING, AMENITIES, todoMark } from '@/lib/site';
import { breadcrumbs, faqPage } from '@/lib/schema';

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Membership', href: '/membership' },
];

const inr = (n: number) => `₹${n.toLocaleString('en-IN')}`;
const everyPlan = [
  'Free high-speed Wi-Fi + backup line',
  'Power backup',
  'Unlimited tea, coffee &amp; beverages',
  'Printing',
  'AC and daily housekeeping',
  'Community events and intros',
  'WhatsApp concierge line',
];

const plans = [
  {
    name: 'Day Pass',
    whoFor: 'Try the room, or drop in when you need it.',
    price: inr(PRICING.dayPass),
    unit: '+ GST / day',
    features: ['Any open seat for the day', ...everyPlan.slice(0, 5), 'No commitment — just turn up'],
  },
  {
    name: 'Open Desk',
    whoFor: 'A desk of your own in the open room.',
    price: inr(PRICING.openDeskMonthly),
    unit: '+ GST / month',
    features: ['Your own desk in the open area', `<strong>${PRICING.studioHours.openDesk} complimentary Mini Studio hours</strong> every month`, ...everyPlan],
  },
  {
    name: 'Private Cabin',
    whoFor: 'A lockable room — solo, or a team of up to 8.',
    price: `from ${inr(PRICING.cabinFrom)}`,
    unit: '+ GST / month',
    featured: true,
    features: [
      `Four sizes: ${inr(PRICING.cabins.small)} · ${inr(PRICING.cabins.big)} · ${inr(PRICING.cabins.bigger)} · ${inr(PRICING.cabins.team)} (${PRICING.teamCabinSeats}-seat team cabin)`,
      'Quiet, lockable, yours',
      `<strong>${PRICING.studioHours.cabin} complimentary Mini Studio hours</strong> every month`,
      ...everyPlan,
    ],
    note: `Cabin terms, written down: 3-month refundable deposit · 11-month term · 2 months' notice · fee fixed for the term · payable monthly in advance by the 5th.`,
  },
];

const addOns = [
  { name: 'Meeting room', price: `${inr(PRICING.meetingRoomPerHour)} + GST / hour`, detail: `Seats ${PRICING.meetingRoomSeats}. Set up before you walk in.` },
  { name: 'Mini Studio', price: `from ${inr(STUDIO_PRICING.tiers[0].price)} + GST / 2-hr session`, detail: `Members save ${STUDIO_PRICING.memberDiscountPct}%. Book with or without a membership.`, href: '/studio' },
];

const faqs = [
  { q: 'Is there a lock-in period?', a: `Day passes have none — turn up, pay for the day, done. Cabins run on an 11-month term with a 3-month refundable deposit and two months' notice, with the fee fixed for the term. We write it down rather than bury it.` },
  { q: 'Can I switch plans later?', a: "Yes — talk to us and we'll move you to whatever fits your rhythm." },
  { q: 'Does membership include the studio?', a: `Yes — open-desk members get ${PRICING.studioHours.openDesk} complimentary studio hours a month, and cabin members get ${PRICING.studioHours.cabin}. Beyond that, members save ${STUDIO_PRICING.memberDiscountPct}% on every session. You can also book the studio with no membership at all.` },
  { q: 'What about the cafeteria?', a: 'Tea, coffee and other beverages are unlimited and included on every plan. Snacks and meals from the on-site cafeteria are chargeable.' },
  { q: 'How do I join?', a: 'Book a tour first — Mini is curated, so we start with a conversation, not a form.' },
];
const faqSchema = faqPage([
  { q: 'Is there a lock-in period?', a: "Day passes have no commitment. Cabins run on an 11-month term with a 3-month refundable deposit and two months' notice." },
  { q: 'Can I switch plans later?', a: "Yes — talk to us and we'll move you to whatever fits your rhythm." },
  { q: 'Does membership include the studio?', a: 'Open-desk members get 2 complimentary studio hours a month and cabin members get 4. Beyond that, members save 25% on every session. The studio can also be booked without a membership.' },
  { q: 'How do I join?', a: 'Book a tour first — Mini is curated, so we start with a conversation, not a form.' },
]);

const offersSchema = {
  '@type': 'Product',
  name: 'Mini Coworking Membership (Jaipur)',
  description:
    'Coworking in Jaipur — day passes, open desks and private cabins for teams of up to eight, each with community, concierge, and studio access.',
  brand: { '@type': 'Brand', name: 'Mini' },
  offers: [
    { '@type': 'Offer', name: 'Day pass', price: PRICING.dayPass, priceCurrency: 'INR', url: `${SITE.url}/membership`, availability: 'https://schema.org/InStock' },
    { '@type': 'Offer', name: 'Open desk (monthly)', price: PRICING.openDeskMonthly, priceCurrency: 'INR', url: `${SITE.url}/membership`, availability: 'https://schema.org/InStock' },
    { '@type': 'AggregateOffer', name: 'Private cabin (monthly)', lowPrice: PRICING.cabins.small, highPrice: PRICING.cabins.team, priceCurrency: 'INR', offerCount: 4, url: `${SITE.url}/membership` },
    { '@type': 'Offer', name: 'Meeting room (hourly)', price: PRICING.meetingRoomPerHour, priceCurrency: 'INR', url: `${SITE.url}/membership`, availability: 'https://schema.org/InStock' },
  ],
};

const schema = [breadcrumbs(crumbs), faqSchema, offersSchema];
---
<Base
  title="Coworking Membership & Pricing in Jaipur | Mini"
  description="Coworking prices in Jaipur — day pass ₹600, open desk ₹9,000 a month, private cabins from ₹20,000, meeting room ₹2,000 an hour. Plus GST. Book a tour."
  schema={schema}
  viewEvent="membership_view"
>
  <Breadcrumbs items={crumbs} />

  <section class="mx-auto max-w-6xl px-4 pb-14 pt-10 text-center sm:px-6 sm:pt-14">
    <h1 class="text-4xl font-semibold leading-[1.1] text-espresso sm:text-5xl">Simple plans. Real numbers.</h1>
    <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-ink/75">
      Every plan includes the curated community and the concierge — you're choosing how much room you need, not
      which tier of service you deserve. Prices below exclude GST.
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6">
    <div class="grid gap-6 lg:grid-cols-3">
      {plans.map((p) => <PricingCard {...p} />)}
    </div>
  </section>

  <!-- Add-ons -->
  <section class="bg-cream">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <h2 class="text-center text-3xl font-semibold text-espresso">Add what you need, when you need it</h2>
      <div class="mx-auto mt-8 grid max-w-3xl gap-5 sm:grid-cols-2">
        {addOns.map((a) => (
          <div class="rounded-3xl bg-white p-7 shadow-card">
            <h3 class="text-lg font-semibold text-espresso">
              {a.href ? <a href={a.href} class="hover:text-amber-deep">{a.name}</a> : a.name}
            </h3>
            <p class="mt-2 font-display text-xl font-semibold text-espresso">{a.price}</p>
            <p class="mt-2 text-sm leading-relaxed text-ink/75">{a.detail}</p>
          </div>
        ))}
      </div>
      <p class="mt-8 text-center text-sm text-ink/70">
        Everything on this page is per person, excluding GST at 18%.
      </p>
    </div>
  </section>

  <!-- What every plan includes -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <h2 class="text-center text-3xl font-semibold text-espresso">Included on every plan</h2>
    <ul class="mx-auto mt-8 flex max-w-4xl flex-wrap items-center justify-center gap-x-8 gap-y-3 text-sm font-semibold text-espresso/80">
      {AMENITIES.map((a) => (
        <li class="flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-teal-brand"></span>{a}</li>
      ))}
    </ul>
    <p class="mt-6 text-center text-sm text-ink/70">
      Beverages are unlimited and included. Snacks and meals from the cafeteria are chargeable.
    </p>
  </section>

  <!-- FAQ -->
  <section class="bg-cream">
    <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
      <h2 class="text-center text-3xl font-semibold text-espresso">Membership FAQ</h2>
      <div class="mt-9"><FAQAccordion items={faqs} /></div>
    </div>
  </section>

  <CTASection
    heading="Not sure which plan? Come feel the room."
    body="Fifteen minutes in the space beats an hour of comparison tables. Book a tour — we'll help you pick."
  />
</Base>
