---
import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
import Doodle from '@/components/Doodle.astro';
---
<Base
  title="Page Not Found — Mini, Jaipur"
  description="That page doesn't exist — but the room does. Head back to Mini, Jaipur's boutique coworking space and creator studio."
>
  <section class="mx-auto max-w-2xl px-4 py-24 text-center sm:px-6">
    <Doodle kind="coffee" class="mx-auto h-14 w-14 text-amber-brand" />
    <h1 class="mt-5 text-4xl font-semibold text-espresso sm:text-5xl">This page wandered off.</h1>
    <p class="mt-5 text-lg leading-relaxed text-ink/75">
      No such page — but the coffee's real and the room is right here.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <Button href="/" size="lg">Back to home</Button>
      <Button href="/contact#tour" size="lg" variant="secondary" event="book_tour_click">Book a tour</Button>
    </div>
  </section>
</Base>
