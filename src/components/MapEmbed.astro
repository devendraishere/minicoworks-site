---
/**
 * Google Map embed for the live GBP listing ("Mini Coworks", Vivek Vihar,
 * Shyam Nagar, Jaipur). Keyless query embed — centers on the business pin.
 */
import { SITE } from '@/lib/site';
const embedSrc = `https://maps.google.com/maps?q=${encodeURIComponent('Mini Coworks, Vivek Vihar, Shyam Nagar, Jaipur')}&z=15&output=embed`;
---
<div class="overflow-hidden rounded-3xl shadow-card">
  <iframe
    src={embedSrc}
    title="Map showing Mini Coworks, Vivek Vihar, Shyam Nagar, Jaipur"
    class="h-72 w-full border-0"
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    allowfullscreen
  ></iframe>
  <a
    href={SITE.mapsUrl}
    target="_blank"
    rel="noopener"
    class="block bg-espresso px-5 py-3 text-center text-sm font-semibold text-cream hover:bg-[#3d2f2a]"
  >Get directions on Google Maps →</a>
</div>
