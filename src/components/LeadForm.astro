---
/**
 * Lead form → emails contact@minicoworks.com via FormSubmit (no backend
 * needed on GitHub Pages; MX is live on Zoho since 2026-07).
 * NOTE: FormSubmit requires a ONE-TIME activation — the first submission
 * triggers an activation email to contact@; forwarding starts after that
 * link is clicked. WhatsApp remains offered as the fast alternative.
 */
import { SITE } from '@/lib/site';
interface Props { defaultInterest?: string }
const { defaultInterest } = Astro.props;
const interests = ['Coworking', 'Studio', 'Membership', 'Incubator'];
const input =
  'w-full rounded-xl border border-espresso/20 bg-white px-4 py-3 text-base text-ink placeholder:text-ink/40 focus:border-amber-brand';
---
<div id="form-success" class="mb-4 hidden rounded-2xl border border-teal-brand/30 bg-teal-brand/10 p-4 text-sm font-medium text-teal-deep" role="status">
  Thanks — we got your message and will reply the same day. Want it instant? <a href={SITE.whatsappUrl} target="_blank" rel="noopener" class="underline underline-offset-2">WhatsApp us</a>.
</div>

<form
  action="https://formsubmit.co/contact@minicoworks.com"
  method="POST"
  class="space-y-4"
>
  <input type="hidden" name="_subject" value="New enquiry — minicoworks.com" />
  <input type="hidden" name="_template" value="table" />
  <input type="hidden" name="_captcha" value="false" />
  <input type="hidden" name="_next" value={`${SITE.url}/contact?sent=1#tour`} />
  <input type="text" name="_honey" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <label for="lead-name" class="mb-1.5 block text-sm font-semibold text-espresso">Name</label>
      <input id="lead-name" name="name" type="text" required autocomplete="name" class={input} />
    </div>
    <div>
      <label for="lead-phone" class="mb-1.5 block text-sm font-semibold text-espresso">Phone</label>
      <input id="lead-phone" name="phone" type="tel" required autocomplete="tel" inputmode="tel" class={input} />
    </div>
  </div>
  <div>
    <label for="lead-email" class="mb-1.5 block text-sm font-semibold text-espresso">Email</label>
    <input id="lead-email" name="email" type="email" required autocomplete="email" class={input} />
  </div>
  <div>
    <label for="lead-interest" class="mb-1.5 block text-sm font-semibold text-espresso">I'm interested in</label>
    <select id="lead-interest" name="interest" class={input}>
      {interests.map((i) => (
        <option value={i} selected={i === defaultInterest}>{i}</option>
      ))}
    </select>
  </div>
  <div>
    <label for="lead-message" class="mb-1.5 block text-sm font-semibold text-espresso">Message</label>
    <textarea id="lead-message" name="message" rows="4" class={input} placeholder="Tell us what you're building, or when you'd like to drop by."></textarea>
  </div>
  <div class="flex flex-wrap items-center gap-4">
    <button
      type="submit"
      class="inline-flex min-h-11 items-center justify-center rounded-full bg-amber-brand px-8 py-3.5 text-base font-semibold text-espresso shadow-card transition-colors hover:bg-[#e89a52]"
    >Send message</button>
    <a href={SITE.whatsappUrl} target="_blank" rel="noopener" data-event="whatsapp_click" class="min-h-11 inline-flex items-center text-sm font-semibold text-teal-deep underline underline-offset-4 hover:text-amber-deep">
      or chat on WhatsApp instead
    </a>
  </div>
</form>

<script>
  // Success banner after FormSubmit redirects back with ?sent=1
  const params = new URLSearchParams(window.location.search);
  if (params.get('sent') === '1') {
    document.getElementById('form-success')?.classList.remove('hidden');
    window.dispatchEvent(new CustomEvent('mini:track', { detail: { event: 'lead_submit' } }));
  }
</script>
