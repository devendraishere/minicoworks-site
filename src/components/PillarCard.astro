---
import Doodle from './Doodle.astro';
interface Props {
  title: string;
  body: string;
  icon?: 'sparkle' | 'coffee' | 'mic' | 'arrow';
  accent?: 'amber' | 'teal' | 'berry' | 'espresso';
}
const { title, body, icon = 'sparkle', accent = 'amber' } = Astro.props;
const accents = {
  amber: 'bg-amber-brand/12 text-amber-deep',
  teal: 'bg-teal-brand/12 text-teal-deep',
  berry: 'bg-berry/12 text-berry',
  espresso: 'bg-espresso/8 text-espresso',
};
---
<article class="rounded-3xl bg-white p-7 shadow-card transition-shadow hover:shadow-card-hover">
  <div class={`flex h-12 w-12 items-center justify-center rounded-2xl ${accents[accent]}`}>
    <Doodle kind={icon} class="h-7 w-7" />
  </div>
  <h3 class="mt-5 text-xl font-semibold text-espresso">{title}</h3>
  <p class="mt-2.5 text-[0.95rem] leading-relaxed text-ink/75">{body}</p>
</article>
