---
// Visible breadcrumb trail; pair with breadcrumbs() JSON-LD via the page `schema` prop.
interface Props { items: { name: string; href: string }[] }
const { items } = Astro.props;
---
<nav aria-label="Breadcrumb" class="mx-auto max-w-6xl px-4 pt-6 sm:px-6">
  <ol class="flex flex-wrap items-center gap-1.5 text-xs text-ink/70">
    {items.map((item, i) => (
      <li class="flex items-center gap-1.5">
        {i > 0 && <span aria-hidden="true">/</span>}
        {i === items.length - 1 ? (
          <span aria-current="page" class="font-semibold text-ink/80">{item.name}</span>
        ) : (
          <a href={item.href} class="hover:text-espresso hover:underline underline-offset-4">{item.name}</a>
        )}
      </li>
    ))}
  </ol>
</nav>
