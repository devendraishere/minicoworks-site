---
import Todo from './Todo.astro';
interface Props {
  name: string;
  line: string;
  href?: string;
  showPrice?: boolean;
}
const { name, line, href, showPrice = true } = Astro.props;
---
<article class="group relative flex flex-col rounded-3xl bg-white p-7 shadow-card transition-shadow hover:shadow-card-hover">
  <h3 class="text-xl font-semibold text-espresso">
    {href ? (
      <a href={href} class="after:absolute after:inset-0 group-hover:text-amber-deep">{name}</a>
    ) : (
      name
    )}
  </h3>
  <p class="mt-2 flex-1 text-[0.95rem] leading-relaxed text-ink/75">{line}</p>
  {showPrice && (
    <p class="mt-4 text-sm font-semibold text-espresso/80">from ₹<Todo label="price" /></p>
  )}
  {href && (
    <span class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-teal-deep group-hover:underline underline-offset-4">
      Learn more
      <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 10h12m-5-5 5 5-5 5"/></svg>
    </span>
  )}
</article>
