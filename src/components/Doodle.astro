---
// Hand-drawn accents (brief §8: warm doodle motif, no corporate stripes).
interface Props { kind?: 'underline' | 'circle' | 'arrow' | 'sparkle' | 'coffee' | 'mic'; class?: string }
const { kind = 'underline', class: className = '' } = Astro.props;
---
{kind === 'underline' && (
  <svg class={className} viewBox="0 0 220 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path d="M3 9.5C40 4 80 3 116 5.5c34 2.4 66 4.5 101 2" stroke="currentColor" stroke-width="5" stroke-linecap="round"/>
  </svg>
)}
{kind === 'circle' && (
  <svg class={className} viewBox="0 0 120 60" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path d="M78 6C38 2 6 14 5 30c-1 17 30 26 60 25 31-1 52-11 51-25-1-12-20-20-42-21" stroke="currentColor" stroke-width="4" stroke-linecap="round"/>
  </svg>
)}
{kind === 'arrow' && (
  <svg class={className} viewBox="0 0 80 60" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path d="M8 8c14 22 32 36 58 40M56 52l12-3-6-12" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
)}
{kind === 'sparkle' && (
  <svg class={className} viewBox="0 0 60 60" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path d="M30 8v14M30 38v14M8 30h14M38 30h14" stroke="currentColor" stroke-width="4" stroke-linecap="round"/>
  </svg>
)}
{kind === 'coffee' && (
  <svg class={className} viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path d="M14 26h30c1 12-3 24-15 24S13 38 14 26Z" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M44 30c6-1 10 2 9 7s-6 6-11 5M22 18c-2-3 2-5 0-8M32 18c-2-3 2-5 0-8" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"/>
  </svg>
)}
{kind === 'mic' && (
  <svg class={className} viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <rect x="24" y="8" width="16" height="28" rx="8" stroke="currentColor" stroke-width="3.5"/>
    <path d="M16 30c0 10 7 16 16 16s16-6 16-16M32 46v10M24 56h16" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"/>
  </svg>
)}
