---
import { NAV } from '@/lib/site';
import Logo from './Logo.astro';
import Button from './Button.astro';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="sticky top-0 z-50 border-b border-espresso/10 bg-cream-soft/90 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href="/" class="flex items-center gap-2" aria-label="Mini — home">
      <Logo class="h-10 w-10 sm:h-11 sm:w-11" />
      <span class="font-display text-2xl font-semibold tracking-tight text-espresso">mini</span>
      <span class="mt-1 hidden text-[0.65rem] font-semibold uppercase tracking-[0.18em] text-espresso/70 md:inline">Work · Record · Grow</span>
    </a>

    <nav aria-label="Main" class="hidden items-center gap-1 lg:flex">
      {NAV.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
          class={`rounded-full px-3.5 py-2 text-sm font-medium transition-colors ${
            isActive(item.href) ? 'bg-espresso/8 text-espresso' : 'text-espresso/70 hover:bg-espresso/5 hover:text-espresso'
          }`}
        >{item.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <Button href="/contact#tour" event="book_tour_click" class="hidden sm:inline-flex">Book a tour</Button>
      <button
        id="menu-toggle"
        type="button"
        class="inline-flex h-11 w-11 items-center justify-center rounded-full text-espresso hover:bg-espresso/5 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path class="icon-open" d="M4 7h16M4 12h16M4 17h16" />
          <path class="icon-close hidden" d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-espresso/10 lg:hidden" >
    <nav aria-label="Mobile" class="mx-auto max-w-6xl space-y-1 px-4 py-4 sm:px-6">
      {NAV.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
          class={`block rounded-xl px-4 py-3 text-base font-medium ${
            isActive(item.href) ? 'bg-espresso/8 text-espresso' : 'text-espresso/75 hover:bg-espresso/5'
          }`}
        >{item.label}</a>
      ))}
      <div class="pt-2">
        <Button href="/contact#tour" event="book_tour_click" class="w-full">Book a tour</Button>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = menu!.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    toggle.querySelector('.icon-open')?.classList.toggle('hidden', open);
    toggle.querySelector('.icon-close')?.classList.toggle('hidden', !open);
  });
</script>
